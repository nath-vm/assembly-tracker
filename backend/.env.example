# Copy this file to .env and fill in real values. NEVER commit .env to git.

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# Comma-separated list of frontend origins allowed by CORS (include https://)
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/DatabaseName?retryWrites=true&w=majority

# ─── Authentication ───────────────────────────────────────────────────────────
# Signs login tokens. Min 32 chars. Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_openssl_rand_-hex_32_OUTPUT

# Starter admin password. Only used on the very first login, when no password
# exists in the database yet; it is then stored as a bcrypt hash. After that,
# change the password from the Settings page. Use 12+ characters.
SECRET_KEY=REPLACE_WITH_A_STRONG_STARTER_PASSWORD

# ─── Image uploads (Cloudinary) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
