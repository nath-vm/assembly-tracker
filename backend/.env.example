# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# MongoDB Cluster
MONGO_URI=mongodb+srv://<username>:<password>@assemblytracker-cluster.vdloqk4.mongodb.net/assembly_tracker?retryWrites=true&w=majority&appName=AssemblyTracker-cluster

# Authentication & Security
JWT_SECRET=your_jwt_secret_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Bootstrap Admin
BOOTSTRAP_ADMIN_EMAIL=your_email@gmail.com

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Resend Email Integration
RESEND_API_KEY=your_resend_api_key_here